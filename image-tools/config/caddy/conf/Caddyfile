{
	order upload before file_server
	log {
		level debug
	}
}

# sub-store - 直接反代，自动添加 API 路径前缀
:8080 {
	# rewrite * ?api=/2cXaAxRGfddmGz2yx1wA{uri}
	reverse_proxy sub-store:3002
}

:80 {
	handle_path /assets/* {
		root * /srv
		file_server browse
	}

	handle_path /upload {
		upload {
			root_dir /srv
			dest_dir_field_name upload_dir
			response_template templates/upload-resp-template.txt
		}
	}

	# gpt-load - 重定向到直接端口
	handle_path /gpt-load* {
		redir http://{http.request.host}:3001{uri} permanent
	}

	# openlist - 重定向到直接端口
	handle_path /openlist* {
		redir http://{http.request.host}:5244{uri} permanent
	}

	# openviking API - 重定向到直接端口
	handle_path /viking/api* {
		redir http://{http.request.host}:1933{uri} permanent
	}

	# openviking web UI - 重定向到直接端口
	handle_path /viking* {
		redir http://{http.request.host}:8020{uri} permanent
	}

	handle_path /sub-store {
		redir http://{http.request.host}:8080?api=/2cXaAxRGfddmGz2yx1wA permanent
	}

	handle /debug {
#		header Content-Type "application/json; charset=utf-8"
		templates
		respond `{{toRawJson .Req.Header}}` 200
	}
}
